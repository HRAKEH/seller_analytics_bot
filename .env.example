TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
OZON_CLIENT_ID=
OZON_API_KEY=
# Wildberries: for the full feature set use a Personal token in read-only mode
# with categories: Statistics, Analytics, Finance, Promotion, Supplies,
# Prices and Discounts.
WB_API_TOKEN=
DB_FILE=./data/seller_analytics.sqlite3
REPORT_TIME=09:00
TIMEZONE=Europe/Moscow
# Значения ниже используются как bootstrap defaults. После /setup настройки
# конкретного магазина хранятся в SQLite и переживают restart/deploy.
BACKFILL_DAYS=30
HTTP_TIMEOUT=60
OZON_MIN_INTERVAL=65
WB_MIN_INTERVAL=65
DAILY_RETRY_MINUTES=20
DAILY_RETRY_ATTEMPTS=3
PRODUCT_REPORT_DAYS=7
STOCK_VELOCITY_DAYS=14
STOCK_RISK_DAYS=14

# Delayed finance and advertising
FINANCE_LOOKBACK_DAYS=14
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Proactive alerts
ALERTS_ENABLED=true
ALERTS_INTERVAL_MINUTES=60
ALERT_ORDER_DROP_PCT=35
ALERT_ORDER_LOOKBACK_DAYS=7
ALERT_API_STALE_HOURS=26
ALERT_DRR_PCT=25
ALERT_COOLDOWN_MINUTES=1440

# Multi-shop credential profiles.
# DEFAULT uses the variables at the top of this file.
# Additional shops reference a profile name via /shop_add or /shop_profile.
# Example profile SHOP2:
# SELLERBOT_SHOP2_OZON_CLIENT_ID=
# SELLERBOT_SHOP2_OZON_API_KEY=
# SELLERBOT_SHOP2_WB_API_TOKEN=
# SELLERBOT_SHOP2_OZON_PERF_CLIENT_ID=
# SELLERBOT_SHOP2_OZON_PERF_CLIENT_SECRET=

# Database backups
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=14

# Production hardening (v0.12+)
# INSTANCE_ID is generated automatically; set it only when your platform gives each replica a stable ID.
# INSTANCE_ID=
DISTRIBUTED_LOCK_TTL_SECONDS=7200
RETRY_WORKER_INTERVAL_SECONDS=30
RETRY_MAX_ATTEMPTS=6
LOG_FORMAT=json
LOG_LEVEL=INFO

# Optional HTTP probes. Bothost exposes its selected port as PORT; HEALTH_PORT overrides it.
HEALTH_SERVER_ENABLED=false
HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8000

# Onboarding v0.19+: API secrets are configured only here / in hosting environment.
# The Telegram wizard never asks users to paste marketplace tokens into chat.
# After changing credentials restart the app and press "🔌 Проверить подключения".
